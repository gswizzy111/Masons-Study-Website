# Mason's Study environment variables.
# Copy to .env.local for local development (never commit .env.local).
# In production, set these in Netlify: Project configuration > Environment
# variables, with the Builds and Functions scopes. NEXT_PUBLIC_* values are
# baked in at build time, so redeploy after changing one.

# --- Supabase (required) ---------------------------------------------------
# Project URL. Local: http://127.0.0.1:54321 (from `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server only: the background job runner uses it and it
# bypasses RLS. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (required for AI features) --------------------------------------
# Without it the site works, but AI features show "Claude is not connected yet".
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Points the Anthropic SDK at another endpoint (for example a local
# mock in tests). Leave unset in production.
# ANTHROPIC_BASE_URL=

# --- YouTube (optional) -------------------------------------------------------
# YouTube Data API v3 key for video suggestions. Without it, videos fall back
# to YouTube search links.
# YOUTUBE_API_KEY=

# --- Who may use the site -------------------------------------------------------
# Logins are shared with the other app in the same Supabase project, so in
# production list the addresses allowed to use Mason's Study (comma separated).
# Everyone else is turned away at sign-in, in the app and in the AI routes.
# Leave unset locally to allow any account.
# ALLOWED_EMAILS=

# --- Site URL (optional) ------------------------------------------------------
# Absolute URL used in auth email links, for example https://your-site.netlify.app
# Falls back to the request origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
